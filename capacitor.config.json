{
  "appId": "app.mytuner.radio",
  "appName": "MyTuner",
  "webDir": "public",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "allowNavigation": [
      "mytuner.mytunerfr.workers.dev",
      "*.workers.dev",
      "*.mediaset.net",
      "*.msvdn.net",
      "*.unitedradio.it",
      "*.fluidstream.net",
      "*.rds.radio",
      "*.rdstv.radio",
      "*.rcast.net",
      "*.xdevel.com",
      "*.studiocentrale.it",
      "*.akamaized.net",
      "*.streamlock.net"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0c0c0c",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
